# Note: Generated files (config/crd/bases/, config/rbac/role.yaml,
# charts/superset-operator/crds/) are removed from the Rat workdir by
# scripts/check_license.sh before Rat runs. This file handles remaining
# file-level exclusions.
#
# Rat matches these patterns against file NAMES, not paths, so a pattern
# containing a directory component (e.g. `ISSUE_TEMPLATE/.*`) never matches.

# Git
.*\.gitignore
.*\.gitattributes

# Go
.*go\.mod
.*go\.sum

# Generated code
.*zz_generated\.deepcopy\.go

# Kustomize structural files
.*kustomization\.yaml
.*kustomizeconfig\.yaml
.*PROJECT

# Helm chart metadata
.*Chart\.yaml
.*values\.yaml
.*values\.schema\.json

# Helm chart test snapshots (generated by helm-unittest)
.*\.snap

# Documentation
.*api-reference\.md
.*docs-requirements\.txt
.*mkdocs\.yml

# CI / tooling
.*PULL_REQUEST_TEMPLATE\.md
# GitHub issue templates: GitHub requires YAML front matter at the top, and an
# HTML comment would leak into every new issue body.
bug_report\.md
feature_request\.md
.*\.claude.*
# Editor/agent context symlink → AGENTS.md (which carries the header itself)
GEMINI\.md
.*rat-results\.txt
.*Dockerfile\.cross
.*codecov\.yml
.*supported-k8s\.json
